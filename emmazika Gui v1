-- Variaveis para remotes
local HD_REMOTE = nil
local F3X_REMOTE = nil
local remoteScanned = false

local function scanRemotes()
    if remoteScanned then return end
    remoteScanned = true

    local hdNames = {"HDAdminRemote", "MainRemote", "HDAdmin", "AdminRemote", "Commands", "HD_Remote"}
    local f3xNames = {"F3XRemote", "BuildRemote", "Remote", "BuildService"}

    for _, name in ipairs(hdNames) do
        local obj = ReplicatedStorage:FindFirstChild(name)
        if obj and obj:IsA("RemoteEvent") then
            HD_REMOTE = obj
            break
        end
    end

    for _, name in ipairs(f3xNames) do
        local obj = ReplicatedStorage:FindFirstChild(name)
        if obj and obj:IsA("RemoteEvent") then
            F3X_REMOTE = obj
            break
        end
    end

    -- Notificacao de scan
    local notif = Instance.new("Frame", ScreenGui)
    notif.Size = UDim2.new(0, 320, 0, 40)
    notif.Position = UDim2.new(0.5, -160, 1, 10)
    notif.BackgroundColor3 = COLORS.HEADER
    notif.BorderSizePixel = 2
    notif.BorderColor3 = COLORS.ACCENT
    local text = Instance.new("TextLabel", notif)
    text.Size = UDim2.new(1, -8, 1, 0)
    text.Position = UDim2.new(0, 4, 0, 0)
    text.BackgroundTransparency = 1
    text.TextColor3 = COLORS.TEXT
    text.Font = Enum.Font.GothamBold
    text.TextSize = 10
    text.Text = string.format("[SCAN] HD: %s | F3X: %s",
        HD_REMOTE and ("OK:" .. HD_REMOTE.Name) or "N/A",
        F3X_REMOTE and ("OK:" .. F3X_REMOTE.Name) or "N/A"
    )
    TweenService:Create(notif, TweenInfo.new(0.4), {Position = UDim2.new(0.5, -160, 1, -50)}):Play()
    task.wait(4)
    TweenService:Create(notif, TweenInfo.new(0.4), {Position = UDim2.new(0.5, -160, 1, 10)}):Play()
    task.wait(0.5)
    notif:Destroy()
end
task.spawn(scanRemotes)

local function hdCommand(cmd)
    if not HD_REMOTE then scanRemotes() end
    if HD_REMOTE then pcall(function() HD_REMOTE:FireServer(cmd) end) end
end

local function f3xFire(...)
    if not F3X_REMOTE then scanRemotes() end
    if F3X_REMOTE then pcall(function() F3X_REMOTE:FireServer(...) end) end
end

local function f3xSetProperty(obj, prop, value)
    f3xFire("ChangeProp", obj, prop, value)
    pcall(function()
        if prop == "BrickColor" then obj.BrickColor = value
        elseif prop == "Material" then obj.Material = value
        elseif prop == "Anchored" then obj.Anchored = value
        elseif prop == "Transparency" then obj.Transparency = value
        end
    end)
end

