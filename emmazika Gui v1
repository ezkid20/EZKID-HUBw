-- Funcao para criar scrolling grid
local function createScrollingGrid(parent, cellWidthPercent, cellHeight)
    local scroll = Instance.new("ScrollingFrame", parent)
    scroll.Size = UDim2.new(1, 0, 1, 0)
    scroll.BackgroundColor3 = COLORS.BG
    scroll.BorderSizePixel = 0
    scroll.ScrollBarThickness = 4
    scroll.ScrollBarImageColor3 = COLORS.ACCENT
    scroll.CanvasSize = UDim2.new(0, 0, 0, 0)

    local grid = Instance.new("UIGridLayout", scroll)
    grid.CellSize = UDim2.new(cellWidthPercent, -6, 0, cellHeight)
    grid.CellPadding = UDim2.new(0, 4, 0, 6)
    grid.SortOrder = Enum.SortOrder.LayoutOrder

    local padding = Instance.new("UIPadding", scroll)
    padding.PaddingLeft = UDim.new(0, 6)
    padding.PaddingTop = UDim.new(0, 6)

    grid:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        scroll.CanvasSize = UDim2.new(0, 0, 0, grid.AbsoluteContentSize.Y + 12)
    end)

    return scroll, grid
end

-- Funcao para criar botao padrao
local function createButton(parent, text, order, callback)
    local btn = Instance.new("TextButton", parent)
    btn.BackgroundColor3 = COLORS.CELL
    btn.BorderSizePixel = 1
    btn.BorderColor3 = COLORS.ACCENT
    btn.Text = text
    btn.TextColor3 = COLORS.TEXT
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 10
    btn.TextWrapped = true
    btn.LayoutOrder = order

    btn.MouseButton1Click:Connect(function()
        local originalBorder = btn.BorderColor3
        btn.BorderColor3 = COLORS.TEXT
        task.spawn(function()
            local success = pcall(callback)
            task.wait(0.15)
            btn.BorderColor3 = success and Color3.fromRGB(0, 200, 0) or COLORS.TEXT
            task.wait(1.0)
            btn.BorderColor3 = originalBorder
        end)
    end)
    return btn
end

