local function lmBtn(parent, text, order, fn)
    local b = Instance.new("TextButton", parent)
    b.BackgroundColor3 = Color3.fromRGB(0,0,0)
    b.BorderSizePixel = 1
    b.BorderColor3 = Color3.fromRGB(255,255,255)
    b.Text = text
    b.TextColor3 = Color3.fromRGB(255,255,255)
    b.TextStrokeTransparency = 0
    b.TextStrokeColor3 = Color3.fromRGB(255,0,0)
    b.Font = Enum.Font.GothamBold
    b.TextSize = 10
    b.TextWrapped = true
    b.LayoutOrder = order
    b.MouseButton1Click:Connect(function()
        b.BorderColor3 = Color3.fromRGB(255,0,0)
        task.spawn(function()
            local ok = pcall(fn)
            task.wait(0.2)
            b.BorderColor3 = ok
                and Color3.fromRGB(0,200,0)
                or Color3.fromRGB(255,0,0)
            task.wait(1)
            b.BorderColor3 = Color3.fromRGB(255,255,255)
        end)
    end)
end

-- funcao reutilizavel pra qualquer skybox
local function launchSky(skyId)
    local player = lp
    local char = player.Character or player.CharacterAdded:Wait()
    local tool
    for _,v in ipairs(player:GetDescendants()) do
        if v.Name == "SyncAPI" then tool = v.Parent end
    end
    for _,v in ipairs(game:GetService("ReplicatedStorage"):GetDescendants()) do
        if v.Name == "SyncAPI" then tool = v.Parent end
    end
    if not tool then return end
    local remote = tool.SyncAPI.ServerEndpoint
    local RS2 = game:GetService("RunService")
    local function _(args) remote:InvokeServer(unpack(args)) end
    local function CreatePart(cf,parent)
        _({[1]="CreatePart",[2]="Normal",[3]=cf,[4]=parent})
    end
    local function SetAnchor(part,bool)
        _({[1]="SyncAnchor",[2]={{["Part"]=part,["Anchored"]=bool}}})
    end
    local function AddMesh(part)
        _({[1]="CreateMeshes",[2]={{["Part"]=part}}})
    end
    local function SetMesh(part,id)
        _({[1]="SyncMesh",[2]={{["Part"]=part,["MeshId"]="rbxassetid://"..id}}})
    end
    local function SetTexture(part,tex)
        _({[1]="SyncMesh",[2]={{["Part"]=part,["TextureId"]=tex}}})
    end
    local function MeshResize(part,size)
        _({[1]="SyncMesh",[2]={{["Part"]=part,["Scale"]=size}}})
    end
    local function SetTransparency(part,val)
        _({[1]="SyncTransparency",[2]={{["Part"]=part,["Transparency"]=val}}})
    end
    local images = {}
    for i = 1,8 do
        images[i] = "http://www.roblox.com/asset/?id="..skyId
    end
    local skyPart, skyLoop = nil, nil
    local frameTime, lastUpdate = 1/10, 0
    local function CreateSky()
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        local cf = hrp.CFrame
        CreatePart(CFrame.new(cf.Position+Vector3.new(0,6,0)), workspace)
        local found = false
        for i = 1,50 do
            task.wait()
            for _,v in ipairs(workspace:GetDescendants()) do
                if v:IsA("BasePart") and
                (v.Position-(cf.Position+Vector3.new(0,6,0))).Magnitude < 1 then
                    skyPart = v
                    found = true
                    break
                end
            end
            if found then break end
        end
        if not skyPart then return end
        SetAnchor(skyPart, true)
        AddMesh(skyPart)
        SetMesh(skyPart, "111891702759441")
        MeshResize(skyPart, Vector3.new(9000,9000,9000))
        SetTransparency(skyPart, 0)
        local index = 1
        skyLoop = RS2.Heartbeat:Connect(function(dt)
            lastUpdate = lastUpdate + dt
            if lastUpdate >= frameTime then
                lastUpdate = 0
                if not skyPart then skyLoop:Disconnect() return end
                SetTexture(skyPart, images[index])
                index = (index % #images) + 1
            end
        end)
    end
    task.spawn(CreateSky)
end

